{
  "compilerOptions": {
    "target": "ES2022",
    // Mirrors the SDK's own lib: its Web-search executor options name
    // `AbortSignal`, a web-standard global that `esnext` alone does not declare.
    // A plugin with `@types/node` gets it from there instead.
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["index.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
