{
  "compilerOptions": {
    "target": "ES2022",
    // `dom` is here for one web-standard global: `URL`, which `isPresentableUrl`
    // constructs. `Buffer`, used to bound sandbox env sizes, comes from `node`
    // via the `@types/node` devDependency.
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
