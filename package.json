{
  "name": "platypus",
  "version": "4.4.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build-docker": "turbo run build-docker",
    "cleanup-docker": "docker rmi -f $(docker images willdady/platypus-frontend --format \"{{.Repository}}:{{.Tag}}\" | grep -v \"latest\" | xargs) && docker rmi -f $(docker images willdady/platypus-backend --format \"{{.Repository}}:{{.Tag}}\" | grep -v \"latest\" | xargs)",
    "dev": "turbo run dev --filter=!@platypus/docs --filter=!@platypus/website",
    "docs-build": "turbo run build -F @platypus/docs",
    "docs-dev": "pnpm --filter @platypus/docs dev",
    "docs-preview": "pnpm --filter @platypus/docs run preview",
    "docs-deploy": "pnpm --filter @platypus/docs run deploy",
    "docs-upload": "pnpm --filter @platypus/docs run upload",
    "website-build": "turbo run build -F @platypus/website",
    "website-dev": "pnpm --filter @platypus/website dev",
    "website-preview": "pnpm --filter @platypus/website run preview",
    "website-deploy": "pnpm --filter @platypus/website run deploy",
    "website-upload": "pnpm --filter @platypus/website run upload",
    "gen:og": "node ./scripts/generate-og-image.ts",
    "smoke": "node ./scripts/smoke.ts",
    "drizzle-kit-push": "turbo run drizzle-kit-push -F @platypus/backend",
    "drizzle-kit-generate": "turbo run drizzle-kit-generate -F @platypus/backend",
    "drizzle-kit-migrate": "turbo run drizzle-kit-migrate -F @platypus/backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  }
}
