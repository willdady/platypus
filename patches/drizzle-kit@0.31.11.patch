diff --git a/api.js b/api.js
index f4ecb91959f62fc938416a0585458c0a710af161..f70098af252fe903638851446060c149577b09c4 100644
--- a/api.js
+++ b/api.js
@@ -23174,12 +23174,17 @@ WHERE
             const checkConstraints = {};
             const tableResponse = await getColumnsInfoQuery({ schema: tableSchema, table: tableName, db });
             const tableConstraints = await db.query(
-              `SELECT c.column_name, c.data_type, constraint_type, constraint_name, constraint_schema
+              `SELECT c.column_name, c.data_type, constraint_type, constraint_name, constraint_schema,
+        (SELECT i.indnullsnotdistinct FROM pg_constraint pc JOIN pg_index i ON i.indexrelid = pc.conindid
+          WHERE pc.conname = tc.constraint_name AND pc.connamespace = tc.constraint_schema::text::regnamespace) AS nulls_not_distinct
       FROM information_schema.table_constraints tc
       JOIN information_schema.constraint_column_usage AS ccu USING (constraint_schema, constraint_name)
       JOIN information_schema.columns AS c ON c.table_schema = tc.constraint_schema
         AND tc.table_name = c.table_name AND ccu.column_name = c.column_name
-      WHERE tc.table_name = '${tableName}' and constraint_schema = '${tableSchema}';`
+      WHERE tc.table_name = '${tableName}' and constraint_schema = '${tableSchema}'
+      ORDER BY constraint_name, (SELECT kcu.ordinal_position FROM information_schema.key_column_usage AS kcu
+        WHERE kcu.constraint_schema = tc.constraint_schema AND kcu.constraint_name = tc.constraint_name
+          AND kcu.column_name = ccu.column_name);`
             );
             const tableChecks = await db.query(`SELECT 
 						tc.constraint_name,
@@ -23288,7 +23293,7 @@ WHERE
               } else {
                 uniqueConstrains[constraintName] = {
                   columns: [columnName],
-                  nullsNotDistinct: false,
+                  nullsNotDistinct: unqs.nulls_not_distinct === true,
                   name: constraintName
                 };
               }
