# =============================================================================
# Platypus Environment Configuration (Docker Compose)
# =============================================================================
# Copy this file to .env and edit the values below.
#
#   cp .env.example .env
#
# Docker Compose loads .env automatically. Variables defined here are injected
# into both the backend and frontend services via env_file.
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# A secure random string used to sign auth tokens (minimum 32 characters).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Credentials for the initial admin user, created on first startup against a
# database with no organizations. REQUIRED: with either unset the backend logs a
# fatal error and exits without starting. Seeding runs once and never again, so
# changing these later has no effect -- manage users in the app instead.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# IANA timezone name (e.g., "America/New_York", "Europe/London").
# Used by the time tools only -- getCurrentTime and convertTimezone. It does NOT
# set the zone a trigger's cron schedule runs in (each trigger carries its own
# timezone field) and does not affect log timestamps. Defaults to UTC.
TIMEZONE="UTC"

# How often (in milliseconds) the background memory extraction job runs.
# Default: 300000 (5 minutes)
# MEMORY_EXTRACTION_INTERVAL_MS=300000

# Maximum number of scheduled agent runs to execute in parallel.
# Default: 5
# SCHEDULE_MAX_CONCURRENT=5

# Log level for the backend server. Options: debug, info, warn, error.
# Default: info
# LOG_LEVEL=info

# Comma-separated list of allowed CORS origins. Must include the URL where
# users access the frontend in their browser. REQUIRED: the backend reads this at
# startup and throws before the server listens if it is unset.
# Change this together with FRONTEND_URL and BACKEND_URL below -- updating only
# some of them signs users straight back out after a successful sign-in.
ALLOWED_ORIGINS="http://localhost:3000"

# The public URL of the frontend, used for generating resource links in tool
# responses. Change this if you expose Platypus on a different host or port.
FRONTEND_URL="http://localhost:3000"

# The public URL of the backend API. Used by the frontend for client-side
# requests and by better-auth for callbacks and redirects.
BACKEND_URL="http://localhost:4000"

# Parent domain that session cookies are issued for. Only needed when the
# frontend and backend sit on two subdomains of one parent domain (e.g.
# app.example.com and api.example.com) -- set it to the bare shared parent
# (example.com), not a URL and not a leading-dot form. Leave it unset for a
# single-host deployment. The backend refuses to start on a topology that
# cannot authenticate server-rendered requests, and the fatal message names
# this variable.
# AUTH_COOKIE_DOMAIN=example.com

# Whether tools that fetch a MODEL-CHOSEN url (the web-fetch tool, and web-search
# backends) may reach private networks: 10/8, 172.16/12, 192.168/16, fc00::/7.
# Allowed by default so agents can read internal wikis and intranet pages. Set to
# false on an internet-facing deployment where agents never need internal hosts.
# Loopback, 0.0.0.0/8, link-local 169.254/16 (cloud metadata) and 100.64/10 are
# blocked either way, as are non-http(s) schemes.
# Default: true
# EGRESS_ALLOW_PRIVATE_NETWORKS=true

# -----------------------------------------------------------------------------
# Plugins
# -----------------------------------------------------------------------------

# Comma-separated OPTIONAL plugins to load and enable at boot (fail-loud on error).
# For these, list membership IS the enable switch (ADR-0013). The essential core
# tool sets -- @platypus/tools-basic and @platypus/tools-platform -- load
# unconditionally and are NOT listed here; listing one is a fatal error.
# There is no default in code: unset or empty means NO optional plugins at all,
# including no web-fetch. You still get the always-on core tool sets. The value
# below is this file's choice, not a fallback the backend applies.
# Drop @platypus/web-fetch to deny network egress in isolation. The sandbox
# backends are opt-in: add @platypus/docker or @platypus/ssh.
# NOTE: compose.sandbox.yaml REPLACES this value rather than appending to it, so
# when you run that overlay, edit the list inside it instead.
PLATYPUS_PLUGINS=@platypus/web-fetch

# Deploy-time, Operator-owned plugin config/credentials -- a single JSON object
# keyed by plugin NAME (the manifest name; for a third-party plugin a short slug,
# NOT the npm package specifier you list above). Each entry is an optional
# "config" (non-secret) and "credentials" (secret) block, validated at boot
# against the plugin's manifest schemas (fail-loud); a key matching no loaded
# plugin is also a fatal error. The one block is shared deployment-wide across all
# of that plugin's contributions and every tenant -- distinct from per-Workspace
# Sandbox config. Unset by default; treat like any secret-bearing env var.
# PLATYPUS_PLUGIN_CONFIG={"@platypus/docker":{"config":{"allowedNetworks":["shared-services","public-tools"]}},"cloud-sandbox":{"config":{"region":"eu"},"credentials":{"apiToken":"dtn_live_..."}}}

# -----------------------------------------------------------------------------
# Storage (backend only)
# -----------------------------------------------------------------------------

# Storage backend for file attachments. Options: disk, s3
STORAGE_BACKEND=disk

# Path inside the container where files are stored when using disk storage.
# This should match the volume mount in compose.yaml.
STORAGE_DISK_PATH=/data/files

# To use S3-compatible storage, set STORAGE_BACKEND=s3 and uncomment the
# variables below. Bucket, access key and secret are required; region defaults to
# us-east-1 and the endpoint is only needed for non-AWS S3-compatible services.
# STORAGE_S3_BUCKET=my-bucket
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# STORAGE_S3_ACCESS_KEY_ID=your-access-key
# STORAGE_S3_SECRET_ACCESS_KEY=your-secret-key

# Optional: public URL to serve files directly from your storage provider
# instead of proxying through the backend (e.g., via CDN).
# STORAGE_PUBLIC_URL=https://my-bucket.s3.amazonaws.com

# -----------------------------------------------------------------------------
# Frontend (optional)
# -----------------------------------------------------------------------------

# Base path for the frontend application (e.g., "/platypus").
# Only needed if you serve Platypus behind a reverse proxy with a path prefix.
# BUILD-TIME ONLY: Next.js bakes basePath into the compiled output, so setting it
# here has no effect on the published image. You have to build your own frontend
# image with BASE_PATH set in the build environment.
# BASE_PATH=